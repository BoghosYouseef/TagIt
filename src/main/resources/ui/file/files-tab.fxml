<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="FilesRootPane" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tagit.file.FilesTabController">
    <top>
        <BorderPane>
            <left>
                <VBox  style="-fx-padding: 16; -fx-border-color: #8b5a8b33; -fx-border-width: 0 0 1 0; -fx-background-color: -bg-color;">
                    <Label text="Browse and manage your files" style="-fx-font-size: 12; -fx-text-fill: #a0a0a0; -fx-padding: 4 0 0 0;" />
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <!-- <Label text="Files" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;" /> -->
                        <Label fx:id="fileCountLabel" text="" style="-fx-font-size: 14; -fx-text-fill: #a0a0a0;" />
                    </HBox>
                </VBox>
            </left>
            <center>
                <VBox fx:id="searchBarVBox" alignment="CENTER">
                    <BorderPane.margin>
                        <Insets topRightBottomLeft="10"/>
                    </BorderPane.margin>
                    <TextField fx:id="searchBar" editable="true" style="-fx-padding:20; -fx-background-radius: 15; -fx-border-radius: 15;">
                    </TextField>
                    <FlowPane fx:id="TagFilter" vgap="10" hgap="10" style="-fx-padding:10;">
                    </FlowPane>
                </VBox>
            </center>
            <right>
                <VBox style="-fx-padding: 10; -fx-alignment:center;" >
                    <Button fx:id="importButton" text="+ Import Files" onAction="#onImport" />
                </VBox>
            </right>
        </BorderPane>
    </top>
    <center>
        <TableView 
            fx:id="filesTable"
            maxWidth="Infinity"
            minWidth="600" 
            maxHeight="Infinity" 
            prefWidth="800"
            >
            <columns>                
                <TableColumn fx:id="nameColumn" styleClass="file-column" />
                <TableColumn fx:id="typeColumn" styleClass="file-column" />
                <TableColumn fx:id="sizeColumn" styleClass="file-column" />
                <TableColumn fx:id="lastModifiedAtColumn" styleClass="file-column" />
                <TableColumn fx:id="tagsColumn" styleClass="file-column"  />
                <TableColumn fx:id="locationColumn" styleClass="file-column" />
                <TableColumn fx:id="actionsColumn" />
            </columns>       
        </TableView>    
    </center>
</BorderPane>
